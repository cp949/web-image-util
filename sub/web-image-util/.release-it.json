{
  "$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
  "git": {
    "commit": true,
    "tag": true,
    "push": true,
    "commitMessage": "chore: release ${version}",
    "tagName": "v${version}",
    "requireCleanWorkingDir": true
  },
  "github": false,
  "npm": {
    "publish": true,
    "publishPath": "."
  }
}
